{
  "name": "jsqubits",
  "version": "2.1.3",
  "type": "module",
  "description": "Quantum computation simulation JavaScript library",
  "keywords": [
    "quantum"
  ],
  "license": "MIT",
  "author": "David Kemp <davidbkemp@gmail.com>",
  "files": [
    "lib"
  ],
  "devDependencies": {
    "@rollup/plugin-terser": "^1.0.2",
    "chai": "^6.2.2",
    "eslint": "^10.14.0",
    "eslint-plugin-mocha": "^11.2.0",
    "mocha": "^12.0.3",
    "rollup": "^4.68.0",
    "sinon": "^22.0.0"
  },
  "overrides": {
    "glob": "^14.0.4",
    "minimatch": "^11.0.5"
  },
  "scripts": {
    "build": "rollup --config",
    "lint": "eslint --ext .js ./lib ./spec browser.js rollup.config.js",
    "test-only": "mocha $NODE_DEBUG_OPTION --reporter spec \"spec/**/*.spec.js\"",
    "test": "npm run lint && npm run test-only",
    "example": "node $NODE_DEBUG_OPTION",
    "all-examples": "node $NODE_DEBUG_OPTION examples/algorithms/all.js",
    "clean": "rm -rf package-lock.json node_modules bower_components"
  },
  "main": "./lib/index.js",
  "repository": "git://github.com/davidbkemp/jsqubits.git",
  "homepage": "https://davidbkemp.github.io/jsqubits/"
}
